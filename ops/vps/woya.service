[Unit]
Description=WOYA storefront and admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=woya
Group=woya
WorkingDirectory=/var/www/woya-current
LoadCredential=runtime:/etc/woya/runtime.json
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=PORT=3180
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /usr/local/lib/woya/run.mjs /usr/local/lib/woya/launch.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/woya-releases /var/lib/woya/uploads /var/lib/woya/private-documents
UMask=0027

[Install]
WantedBy=multi-user.target
