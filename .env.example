# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DATABASE_URL=
# Initial setup only. Afterwards the database hash is authoritative; change it in /admin/guvenlik.
# Generate with pnpm admin:password. Escape bcrypt dollar signs as \$ for Next.js.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# VPS: local. Vercel: blob. Local storage is explicitly blocked on Vercel.
STORAGE_DRIVER=local
# Absolute path, outside the app release directory; owned by the app user.
UPLOAD_DIR=
BLOB_READ_WRITE_TOKEN=

# Only used by compose.yaml when hosting PostgreSQL locally/on the VPS.
DB_PASSWORD=

# Optional: no network calls or imports occur without credentials.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

NEXT_PUBLIC_SITE_URL=https://woyatablo.com

# PayTR iFrame API. Keep disabled until database migration, public HTTPS callback,
# legal documents, shipping and an end-to-end PayTR test are verified.
PAYTR_ENABLED=false
PAYTR_TEST_MODE=1
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# VPS proxy must overwrite this single-IP header; block direct access to Node.
PAYTR_TRUSTED_IP_HEADER=x-real-ip
# Optional external IP for local test mode ONLY. Never use in live mode.
PAYTR_TEST_USER_IP=
# Shipping and fulfillment terms are managed in /admin/magaza (database).
# Review the documents and complete LEGAL.md before assigning a live legal version.
CHECKOUT_TERMS_PATH=/yasal/mesafeli-satis-sozlesmesi
CHECKOUT_INFORMATION_PATH=/yasal/on-bilgilendirme-formu
CHECKOUT_LEGAL_VERSION=

# Customer accounts are independent of admin credentials. Server-only values.
# Generate a fresh random value of at least 32 characters; do not reuse ADMIN_SESSION_SECRET.
CUSTOMER_AUTH_SECRET=
# Resend HTTPS API. Verify the sending domain before using a real sender.
CUSTOMER_EMAIL_API_KEY=
CUSTOMER_EMAIL_FROM=
# Optional: a single-IP header OVERWRITTEN by your trusted reverse proxy.
# Leave empty for a conservative shared IP bucket; never trust a client-supplied header.
CUSTOMER_TRUSTED_IP_HEADER=

# Commerce worker, signed delivery callbacks, private invoice storage
RESEND_WEBHOOK_SECRET=
MAIL_WORKER_SECRET=
PRIVATE_DOCUMENT_DIR=
# Set true only after real PayTR test, email delivery and merchant documents verified.
COMMERCE_LIVE_VERIFIED=false
